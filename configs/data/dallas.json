  "anchor_contract": {
    "source_table": "officers",
    "source_key": "full_name",
    "interpretation": "Exact full_name group across incident participation rows, as used in each original SQL; not a physical primary key or independently verified person identity.",
    "runtime_entity_view": "officer_entities",
    "runtime_entity_key": "full_name"
  },
  "feature_policy": "DATE events and their linked officer/subject participation rows become visible at next-day midnight. At a midnight reference time use incident date < reference date. Hide undated final outcomes, narratives and external document links.",
  "label_policy": "Preserve each original SQL window (reference_date, reference_date+horizon_days], exact name string, filters, distinct case counting and explicit COALESCE semantics. Complete label availability is inclusive end date + 1 day.",
  "sampling_policy": "Historical eligibility on a fixed 7-day reference grid; SQL-derived outcomes; outcome strata; seed 42; five supports per parent (two nonzero, three zero). No duplicate bound SQL. Connected components of co-incident officer names assigned to one split, shared by QA and support. Distinct reference windows may share an event within the same split; do not treat them as independent events.",
  "head_training_policy": "Train on support/train, select on support/validation, and keep original qa/test as the current main test. Revised support/test is reserved for separate final evaluation, never per-query adaptation.",
  "original_qa_prediction_policy": "Outcome-stratified diagnostic sample, approximately 50% zero/nonzero separately for each prediction head; not natural prevalence.",
  "qa_split_policy": "Existing nonprediction splits unchanged. Prediction question IDs/task templates retained, anchors and reference times rebuilt with disjoint officer/incident components across train, validation and test.",
  "comparison_policy": "Outcome-stratified prediction release. Rebuild Dallas 05 and affected 01 caches. Holdout_dallas source heads can be reused; other holdout heads require retraining to incorporate new Dallas support. Reasoning QA unchanged.",
  "support_test_usage": "evaluation_only",
  "support_test_temporal_release": "support_test_strict_future_evaluation_v1",
  "support_test_reference_time_min": "2013-12-29 00:00:00",
  "support_test_allow_missing_parents": false,
  "test_support_policy": "Final temporal evaluation instances only; not adaptation data. Existing qa/test remains the current experiment cohort."
}
